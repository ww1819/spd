<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.spd.foundation.mapper.FdJcPeriodMapper">

    <resultMap type="com.spd.foundation.domain.FdJcPeriod" id="FdJcPeriodResult">
        <id     property="id"         column="id" />
        <result property="name"       column="name" />
        <result property="startYm"    column="start_ym" />
        <result property="endYm"      column="end_ym" />
        <result property="isUse"      column="is_use" />
        <result property="remark"     column="remark" />
        <result property="delFlag"    column="del_flag" />
        <result property="createBy"   column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="deleteBy"   column="delete_by" />
        <result property="deleteTime" column="delete_time" />
        <result property="tenantId"   column="tenant_id" />
    </resultMap>

    <sql id="selectVo">
        select id, name, start_ym, end_ym, is_use, remark, del_flag,
               create_by, create_time, update_by, update_time, delete_by, delete_time, tenant_id
        from fd_jc_period
    </sql>

    <select id="selectFdJcPeriodById" resultMap="FdJcPeriodResult">
        <bind name="scopedTenantId" value="@com.spd.common.utils.SecurityUtils@requiredScopedTenantIdForSql()" />
        <include refid="selectVo"/>
        where id = #{id} and tenant_id = #{scopedTenantId} and ifnull(del_flag, 0) = 0
    </select>

    <select id="selectFdJcPeriodList" parameterType="com.spd.foundation.domain.FdJcPeriod" resultMap="FdJcPeriodResult">
        <bind name="scopedTenantId" value="@com.spd.common.utils.SecurityUtils@requiredScopedTenantIdForSql()" />
        <include refid="selectVo"/>
        where tenant_id = #{scopedTenantId} and ifnull(del_flag, 0) = 0
        <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
        <if test="startYm != null and startYm != ''"> and start_ym &gt;= #{startYm}</if>
        <if test="endYm != null and endYm != ''"> and end_ym &lt;= #{endYm}</if>
        <if test="isUse != null and isUse != ''"> and is_use = #{isUse}</if>
        order by start_ym desc, id desc
    </select>

    <insert id="insertFdJcPeriod" parameterType="com.spd.foundation.domain.FdJcPeriod" useGeneratedKeys="true" keyProperty="id">
        <bind name="scopedTenantId" value="@com.spd.common.utils.SecurityUtils@requiredScopedTenantIdForSql()" />
        insert into fd_jc_period
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="startYm != null">start_ym,</if>
            <if test="endYm != null">end_ym,</if>
            <if test="isUse != null">is_use,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            tenant_id,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="startYm != null">#{startYm},</if>
            <if test="endYm != null">#{endYm},</if>
            <if test="isUse != null">#{isUse},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            #{scopedTenantId},
        </trim>
    </insert>

    <update id="updateFdJcPeriod" parameterType="com.spd.foundation.domain.FdJcPeriod">
        <bind name="scopedTenantId" value="@com.spd.common.utils.SecurityUtils@requiredScopedTenantIdForSql()" />
        update fd_jc_period
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="startYm != null">start_ym = #{startYm},</if>
            <if test="endYm != null">end_ym = #{endYm},</if>
            <if test="isUse != null">is_use = #{isUse},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id} and tenant_id = #{scopedTenantId} and ifnull(del_flag, 0) = 0
    </update>

    <update id="deleteFdJcPeriodById">
        <bind name="scopedTenantId" value="@com.spd.common.utils.SecurityUtils@requiredScopedTenantIdForSql()" />
        update fd_jc_period
        set del_flag = 1, delete_by = #{deleteBy}, delete_time = now(), update_time = now()
        where id = #{id} and tenant_id = #{scopedTenantId} and ifnull(del_flag, 0) = 0
    </update>

    <select id="countReportRef" resultType="int">
        <bind name="scopedTenantId" value="@com.spd.common.utils.SecurityUtils@requiredScopedTenantIdForSql()" />
        select count(1) from fd_jc_report
        where tenant_id = #{scopedTenantId} and ifnull(del_flag, 0) = 0 and period_id = #{periodId}
    </select>
</mapper>
